# JobPilot environment configuration
# Copy to .env and fill in the values you need. Never commit .env.

# --- AI provider ---
# One of: mistral, gemini, groq, openai, ollama
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
MISTRAL_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Search provider ---
# One of: tavily, brave, searxng
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARXNG_BASE_URL=

# --- Optional source keys ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# --- App settings ---
CACHE_DIR=./.cache
CACHE_REFRESH_INTERVAL_HOURS=24
DEFAULT_COUNTRIES=worldwide
REQUEST_TIMEOUT_SECONDS=30
PER_DOMAIN_RATE_LIMIT_RPS=1
ROBOTS_TXT_CHECK=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Security / writable settings ---
SETTINGS_WRITABLE=true
WEB_ORIGIN=http://localhost:3000
JOBPILOT_CONFIG_PATH=